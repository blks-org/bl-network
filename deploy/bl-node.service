[Unit]
Description=BL Network Node
After=network.target

[Service]
Type=simple
User=bl
WorkingDirectory=/opt/bl-network
ExecStart=/opt/bl-network/venv/bin/python -m bl.node \
  --data-dir /opt/bl-network/data \
  --key /opt/bl-network/data/validator.priv \
  --genesis /opt/bl-network/data/genesis.json \
  --port 7001 --api-port 8001 \
  --peers IP_1:7001 --peers IP_2:7001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target